{
  "name": "insuccess-team-os",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "test:source": "node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern dist --ignore-pattern .vercel",
    "typecheck": "tsc --noEmit",
    "preflight": "node scripts/launch-preflight.mjs",
    "preflight:example": "node scripts/launch-preflight.mjs --check-example .env.example",
    "preflight:deploy": "node scripts/launch-preflight.mjs --deploy",
    "preflight:schema": "node scripts/schema-contract-preflight.mjs",
    "load:smoke": "node scripts/load-smoke.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.2",
    "ai": "^7.0.85",
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-loading-skeleton": "3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
