NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Public legal/contact identity displayed in the app and store-facing pages.
# Owner/legal review is still required before production submission.
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_LEGAL_ENTITY_NAME=

# Server-only canonical origin for password recovery and invite links. If unset,
# Vercel uses its stable production URL before a deployment-specific preview URL.
PASSWORD_RESET_ORIGIN=https://your-app.example.com

# Server-only. Never rename with NEXT_PUBLIC_ and never commit a real value.
SUPABASE_SECRET_KEY=

# Server-only. Vercel deployments may authenticate AI Gateway with OIDC;
# local development can use an AI Gateway key. Never expose either to the browser.
AI_GATEWAY_API_KEY=
INSUCCESS_AI_MODEL=openai/gpt-5.6-luna
INSUCCESS_ASSESSMENT_MODEL=openai/gpt-5.6-luna

# Server-only pair. Required when Academy uses signed Mux playback.
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=
