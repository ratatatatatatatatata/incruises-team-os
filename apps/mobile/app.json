{
  "expo": {
    "name": "inSuccess Team OS",
    "slug": "tumee",
    "version": "1.0.1",
    "orientation": "portrait",
    "scheme": "insuccessteamos",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.insuccess.teamos",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": "./assets/images/icon-release.png"
    },
    "android": {
      "package": "com.insuccess.teamos",
      "predictiveBackGestureEnabled": false,
      "icon": "./assets/images/icon-release.png"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "ba7265c8-1483-4b4d-bc67-ef96e0dbd427"
      }
    },
    "icon": "./assets/images/icon-release.png"
  }
}
