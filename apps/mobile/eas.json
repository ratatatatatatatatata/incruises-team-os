{
  "cli": { "version": ">= 16.17.4", "appVersionSource": "remote" },
  "build": {
    "development": { "developmentClient": true, "distribution": "internal", "environment": "development" },
    "preview": { "distribution": "internal", "environment": "preview" },
    "production": { "autoIncrement": true, "environment": "production" },
    "store-screenshots": { "extends": "production", "autoIncrement": false, "withoutCredentials": true, "distribution": "internal", "ios": { "simulator": true } }
  },
  "submit": { "production": {} }
}
